NODE_ENV=production
PORT=3000
LOG_LEVEL=info

SITE_NAME=Paragliding Site
SITE_LAT=0
SITE_LON=0
SITE_ALTITUDE_MSL=0
SITE_TIMEZONE=UTC
SITE_IDEAL_HEADING=340
SITE_HEADING_TOLERANCE=35
SITE_MIN_WIND_KMH=12
SITE_MAX_WIND_KMH=26
SITE_MAX_GUST_SPREAD_KMH=8
SITE_MAX_RAIN_PROBABILITY=20
SITE_MAX_PRECIPITATION_MM=1
SITE_MIN_CLOUD_CEILING_M=300
SITE_MAX_CAPE_J_KG=1000

DEEPSEEK_API_KEY=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
PARAGLIDING_CALENDAR_ID=
ALERT_WEBHOOK_URL=
ADMIN_API_TOKEN=
ADMIN_SESSION_SECRET=
ADMIN_WEB_ENABLED=true
ADMIN_SESSION_TTL_HOURS=8
ADMIN_BOOKING_WINDOW_DAYS=14
ADMIN_CONFIG_EVENT_ID=pgpolicy01
SITE_CONFIG_FILE=
